Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: 디스플레이
    Property Tree Widget:
      Expanded:
        - /지도와 좌표계1
        - /센서1
        - /융합 위치1
      Splitter Ratio: 0.55
    Tree Height: 760
  - Class: rviz/Selection
    Name: 선택
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
    Name: 도구 속성
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: 화면
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: 시간
    SyncMode: 0
    SyncSource: 원시 라이다
  - Class: mando_localization/LocalizationStatusPanel
    Name: 로컬리제이션 상태
    Status Topic: /molit/localization/status
    State Topic: /molit/localization/state
    Valid Topic: /molit/localization/valid

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.5
          Cell Size: 1
          Class: rviz/Grid
          Color: 100; 100; 105
          Enabled: true
          Line Style:
            Line Width: 0.03
            Value: Lines
          Name: 기준 격자
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 50
          Reference Frame: <Fixed Frame>
          Value: true
        - Alpha: 0.85
          Class: rviz/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: 현재 지도
          Topic: /map
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Class: rviz/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.6
          Name: TF 트리
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Tree: {}
          Update Interval: 0
          Value: true
      Enabled: true
      Name: 지도와 좌표계
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/LaserScan
          Color: 60; 220; 255
          Color Transformer: FlatColor
          Decay Time: 0.2
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: 원시 라이다
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic: /molit/sensors/lidar/scan
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Enabled: true
      Name: 센서
    - Class: rviz/Group
      Displays:
        - Angle Tolerance: 0.05
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 80
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.35
              Color: 80; 180; 255
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 100
          Name: 최종 차량 위치와 공분산
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 1
            Axes Radius: 0.08
            Color: 80; 180; 255
            Head Length: 0.3
            Head Radius: 0.12
            Shaft Length: 0.8
            Shaft Radius: 0.06
            Value: Arrow
          Topic: /molit/localization/odometry
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 20; 210; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.05
          Name: 주행 궤적
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 20; 210; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic: /molit/localization/path
          Unreliable: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /molit/localization/markers
          Name: 차량과 센서 마커
          Namespaces:
            gps: true
            lidar: true
            path: true
            vehicle: true
          Queue Size: 20
          Value: true
        - Alpha: 0.9
          Axes Length: 0.5
          Axes Radius: 0.05
          Class: rviz/PoseWithCovariance
          Color: 40; 230; 70
          Covariance:
            Orientation:
              Alpha: 0.25
              Color: 40; 230; 70
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.25
              Color: 40; 230; 70
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Head Length: 0.2
          Head Radius: 0.08
          Name: GPS 보정 위치
          Shaft Length: 0.45
          Shaft Radius: 0.04
          Shape: Arrow
          Topic: /molit/localization/gps/map_pose
          Unreliable: false
          Value: true
        - Alpha: 0.9
          Axes Length: 0.5
          Axes Radius: 0.05
          Class: rviz/PoseWithCovariance
          Color: 255; 140; 30
          Covariance:
            Orientation:
              Alpha: 0.25
              Color: 255; 140; 30
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.25
              Color: 255; 140; 30
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Head Length: 0.2
          Head Radius: 0.08
          Name: 라이다 보정 위치
          Shaft Length: 0.45
          Shaft Radius: 0.04
          Shape: Arrow
          Topic: /molit/localization/lidar/map_pose
          Unreliable: false
          Value: true
      Enabled: true
      Name: 융합 위치
  Enabled: true
  Global Options:
    Background Color: 35; 35; 38
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.57079637
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 50
      Target Frame: base_link
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1600
  X: 50
  Y: 50

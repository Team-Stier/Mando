<launch>
  <arg name="enable_lidar_localization" default="false"/>
  <arg name="interfaces_config" default="$(find mando_localization)/config/localization_interfaces.yaml"/>
  <arg name="lidar_config" default="$(find mando_localization)/config/lidar_localization.yaml"/>
  <arg name="gps_reference_config" default="$(find mando_localization)/config/gps_reference.yaml"/>
  <arg name="status_policy_config" default="$(find mando_localization)/config/status_policy.yaml"/>
  <arg name="map_file" default="$(find mando_localization)/maps/map.yaml"/>
  <arg name="map_server_node_name" default="localization_map_server"/>
  <arg name="amcl_node_name" default="localization_amcl"/>
  <arg name="lidar_quality_gate_node_name" default="odometry_lidar_fusion"/>
  <!-- 실제 map.yaml과 base_link -> laser_link 실측 TF가 준비될 때만 활성화한다. -->
  <group if="$(arg enable_lidar_localization)">
    <node pkg="map_server" type="map_server" name="$(arg map_server_node_name)"
          args="$(arg map_file)" output="screen">
      <remap from="map" to="/mando_localization/internal/amcl/map"/>
    </node>

    <node pkg="mando_localization" type="odometry_lidar_fusion_node"
          name="$(arg lidar_quality_gate_node_name)" output="screen" clear_params="true">
      <rosparam command="load" file="$(arg interfaces_config)"/>
      <rosparam command="load" file="$(arg lidar_config)"/>
      <rosparam command="load" file="$(arg gps_reference_config)"/>
      <rosparam command="load" file="$(arg status_policy_config)"/>
    </node>

    <node pkg="amcl" type="amcl" name="$(arg amcl_node_name)"
          output="screen" clear_params="true">
      <rosparam command="load" file="$(arg lidar_config)"/>
      <!-- map -> odom은 Global EKF만 발행한다. -->
      <param name="tf_broadcast" value="false"/>
      <remap from="scan" to="/mando_localization/internal/amcl/scan"/>
      <remap from="amcl_pose" to="/mando_localization/internal/amcl/pose"/>
      <remap from="initialpose" to="/mando_localization/internal/amcl/initialpose"/>
      <remap from="map" to="/mando_localization/internal/amcl/map"/>
    </node>
  </group>
</launch>

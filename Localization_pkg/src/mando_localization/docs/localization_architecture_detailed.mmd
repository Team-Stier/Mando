flowchart TB
  title["mando_localization 상세 데이터·알고리즘 계약<br/>현재 YAML 기본값 기준 · ENU · 2D · 단위 m, m/s, rad"]

  subgraph motion["A. 연속 움직임 추정 · 30 Hz"]
    direction LR
    imu_raw["/molit/sensors/imu/data<br/>sensor_msgs/Imu · imu_link<br/>age ≤ 0.25 s · future ≤ 0.05 s<br/>quaternion 오차 ≤ 0.001<br/>raw covariance=0 관측 · measured override 활성"]
    encoder["Arduino → /erp42_serial/feedback · 약 10 Hz<br/>erp42_msgs/SerialFeedBack · Header 없음<br/>uint8: MorA, EStop, Gear, alive<br/>float64: speed[m/s], steer[ADC]<br/>int16: brake · int32: encoder[최근 0.10 s delta]"]
    normalize["ImuNormalizer<br/>timestamp·frame·finite·quaternion 검사<br/>override stddev²로 양의 covariance 생성<br/>→ /mando_localization/internal/ekf/imu"]
    twist["EncoderToTwistAdapter<br/>finite(speed,steer) · |speed| ≤ 30 m/s<br/>|encoder| ≤ 100000 · steer 0–65535 ADC<br/>alive가 직전 값과 같으면 거부 · uint8 wrap 허용<br/>vx = speed × speed_scale 1.0 × direction_sign 1<br/>stamp=PC receipt time · frame=base_link<br/>Var(vx)=0.25 (m/s)² · 나머지 축=1000000<br/>공개: /molit/vehicle/twist<br/>내부: /mando_localization/internal/ekf/twist"]
    local["Local EKF · robot_localization/ekf_localization_node<br/>30 Hz · sensor_timeout 0.15 s · two_d_mode=true<br/>관측: IMU yaw, vyaw + Twist vx<br/>rejection threshold: 각 입력 5.0<br/>Q diag 핵심: x/y=0.05, yaw=0.03, vx=0.20, vyaw=0.08<br/>출력: /molit/localization/local/odometry<br/>TF 유일 소유: odom → base_link"]
    imu_raw --> normalize --> local
    encoder --> twist --> local
  end

  subgraph gps_path["B. GPS 절대 위치 품질 게이트"]
    direction LR
    gps["/molit/sensors/gps/fix<br/>sensor_msgs/NavSatFix · gps_link<br/>fix status ≥ 0 · age ≤ 1.0 s<br/>horizontal variance ≤ 25 m²<br/>vertical variance ≤ 100 m²"]
    projection["OdometryGpsFusion<br/>datum 주변 WGS84 local tangent 근사<br/>east=N·cos(lat₀)·Δlon<br/>north=M·Δlat<br/>z=map_z + altitude-altitude₀<br/>yaw_offset 회전 + map xyz offset<br/>현재 mode=first_fix · measured=false"]
    gps_gate["GPS Gate<br/>quality-only candidate를 내부 토픽으로 먼저 발행<br/>Local Odom 증분으로 map 위치 예측<br/>연속 후보 간 거리 ≤ 50 m<br/>Euclidean innovation ≤ 10 m<br/>sqrt(innovationᵀ S⁻¹ innovation) ≤ 5.0<br/>초기·짧은 복구 후보 3회 연속 승인"]
    gps --> projection --> gps_gate
  end

  subgraph lidar_path["C. LiDAR + AMCL 절대 위치 품질 게이트 · 기본 비활성"]
    direction LR
    scan["/molit/sensors/lidar/scan<br/>sensor_msgs/LaserScan · laser_link<br/>age ≤ 0.30 s · range 수 ≥ 20<br/>finite 비율 ≥ 0.50"]
    amcl["scan 검사 후 /mando_localization/internal/amcl/scan relay<br/>AMCL likelihood_field<br/>beam=60 · range 0.05–30 m<br/>particles 500–3000 · KLD err=0.05, z=0.99<br/>update: 0.10 m 또는 0.10 rad<br/>tf_broadcast=false"]
    lidar_gate["AMCL pose: age ≤ 0.50 s<br/>position variance ≤ 4.0 m²<br/>yaw variance ≤ 0.2741556778 rad²<br/>즉시 허용: jump ≤ 3.0 m, ≤ 0.7853981634 rad<br/>복구 후보: 반경 ≤ 1.0 m, yaw ≤ 0.35 rad, 3회 연속<br/>→ /molit/localization/lidar/map_pose<br/>PoseWithCovarianceStamped"]
    map["/map · nav_msgs/OccupancyGrid<br/>map_server → /mando_localization/internal/amcl/map<br/>현재 실제 map.yaml 없음"]
    scan --> amcl --> lidar_gate
    map --> amcl
  end

  subgraph global_path["D. 지도 기준 융합 · 30 Hz"]
    direction LR
    global["Global EKF · robot_localization/ekf_localization_node<br/>30 Hz · sensor_timeout 0.20 s · two_d_mode=true<br/>예측: IMU yaw,vyaw + Twist vx<br/>보정: GPS x,y + LiDAR x,y,yaw<br/>모든 입력 rejection threshold=5.0<br/>Local Odom은 상관 중복 때문에 직접 융합하지 않음<br/>Q diag 핵심: x/y=0.20, yaw=0.05, vx=0.25, vyaw=0.10<br/>출력: /molit/localization/global/odometry<br/>TF 유일 소유: map → odom"]
  end

  normalize --> global
  twist --> global
  recovery["RelocalizationCoordinator<br/>이전 anchor + 긴 단절 > 2.0 s<br/>candidate age ≤ 1.0 s · future ≤ 0.10 s<br/>첫 GPS 기준 ≤ 2 m · 증가 GPS stamp만 count<br/>LiDAR fresh + pair skew ≤ 0.20 s<br/>각 GPS↔LiDAR ≤ 5 m · GPS 후보 3회 연속<br/>LiDAR stamp 독립성·EKF 수용 ACK는 미확인<br/>LiDAR pair 불가: 정지 ≤ 0.30 m/s + 후보 5회<br/>measured flag + Global XY 2 m 안 3회<br/>GPS-only 자동 reset 기본 false"]

  gps_gate -. "quality candidate" .-> recovery
  gps_gate -->|"normal gate pose"| recovery
  recovery -->|"단일 /molit/localization/gps/map_pose"| global
  recovery -. "/internal/gps/reanchor_pose<br/>GpsGateReanchor transaction_id" .-> gps_gate
  gps_gate -. "/internal/gps/reanchor_accepted<br/>transaction_id + stamp + XY 일치" .-> recovery
  lidar_gate --> global
  lidar_gate -. "fresh map pose 교차검증" .-> recovery
  local -. "GPS innovation 예측에만 사용" .-> gps_gate
  twist -. "GPS-only 정지 조건" .-> recovery
  recovery -. "/internal/ekf/global_set_pose<br/>GPS-only 기본 false" .-> global
  global -. "post-reset 증가 stamp 결과 3회" .-> recovery

  subgraph safety["E. 상태 판정과 fail-closed 출력 · 20 Hz"]
    direction LR
    manager["LocalizationStatusManager<br/>fresh timeout: IMU/Encoder/Local/Global=0.20 s<br/>GPS=1.00 s · LiDAR=0.50 s<br/>GPS↔LiDAR ≤ 5 m · absolute↔Global ≤ 10 m<br/>DR 한계: 2.0 s 또는 10 m 중 먼저 초과<br/>→ 내부 evaluated status / state / valid"]
    supervisor["LocalizationSupervisor<br/>StatusManager 평가 + recovery heartbeat 중재<br/>evaluation/recovery age ≤ 0.50 s<br/>누락·stale → FAULT · active → RELOCALIZING<br/>공개 /state, /valid, /status 단일 소유"]
    recovery_states["/molit/localization/recovery/state<br/>VALIDATING · WAITING · BLOCKED<br/>TIMEOUT · RECOVERED telemetry"]
    gate["LocalizationOutputGate<br/>valid age ≤ 0.50 s + Global Odom age ≤ 0.20 s<br/>future stamp ≤ 0.05 s · frame map/base_link<br/>finite·quaternion·PSD covariance 재검사<br/>invalid 시 마지막 pose 재발행=false<br/>통과한 메시지만 /molit/localization/odometry"]
    view["LocalizationVisualization · 10 Hz<br/>/molit/localization/path: 최대 2000 poses<br/>0.05 m 또는 0.02 rad 변화 시 추가<br/>invalid 시 Path 삭제<br/>/molit/localization/markers + RViz panel 5 Hz"]
    manager -. "evaluated status / state / valid" .-> supervisor
    recovery -. "recovery state / active" .-> supervisor
    recovery -.-> recovery_states
    supervisor -. "valid / invalid" .-> gate --> view
    supervisor -. "state / status" .-> view
  end

  global --> gate
  normalize -. diagnostics .-> manager
  twist -. diagnostics .-> manager
  local -. diagnostics .-> manager
  recovery -. "최종 GPS pose / relocalizing" .-> manager
  lidar_gate -. diagnostics .-> manager
  global -. diagnostics .-> manager

  warning["운영 전 차단 조건<br/>Arduino Header 없음 → transport/source 지연 미관측<br/>encoder meter-per-tick·steer ADC=unmeasured/비활성<br/>IMU covariance=정지 noise measured, 운영 verified 아님<br/>GPS datum=first_fix/unmeasured<br/>LiDAR localization=false + 실제 map 없음<br/>센서 정적 TF Y/Z/RPY 미측정 → 정확도 검증 전"]
  warning -.-> manager
  title --> motion

  classDef sensor fill:#e8f1ff,stroke:#3973ac,color:#10263d,stroke-width:1px
  classDef process fill:#eaf7ed,stroke:#3e8a50,color:#12351b,stroke-width:1px
  classDef filter fill:#fff2cc,stroke:#bf9000,color:#3d2e00,stroke-width:2px
  classDef safety fill:#fde9e7,stroke:#c74440,color:#4b1110,stroke-width:2px
  classDef view fill:#f0e8ff,stroke:#7651a8,color:#26173d,stroke-width:1px
  classDef note fill:#fff4f2,stroke:#d35400,color:#5a2600,stroke-width:2px

  class imu_raw,encoder,gps,scan,map sensor
  class normalize,twist,projection,gps_gate,amcl,lidar_gate,recovery process
  class local,global filter
  class manager,supervisor,recovery_states,gate safety
  class view view
  class warning note

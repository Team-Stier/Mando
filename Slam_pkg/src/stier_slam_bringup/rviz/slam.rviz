Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Name: Released Map
      Topic: /slam/map/released
      Value: true
    - Class: rviz/PointCloud2
      Name: Leveled LiDAR
      Size (m): 0.03
      Style: Points
      Topic: /slam/scan/leveled_points
      Value: true
    - Class: rviz/PoseWithCovariance
      Name: Localization Pose
      Topic: /slam/localization/pose
      Value: true
    - Class: rviz/PointCloud2
      Name: Live Obstacles
      Size (m): 0.08
      Style: Points
      Topic: /slam/live_obstacles/points
      Value: true
    - Class: rviz/TF
      Frame Timeout: 15
      Name: TF
      Value: true
  Enabled: true
  Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down Ortho
Window Geometry:
  Height: 800
  Width: 1200

<launch>
  <param name="/use_sim_time" value="true" />

  <include file="$(find stier_slam_bringup)/launch/synthetic_demo.launch">
    <arg name="real_mode" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="publish_rate_hz" value="20.0" />
    <arg name="sequence_start_sec" value="100.0" />
    <arg name="cycle_samples" value="40" />
    <arg name="obstacle_start_sample" value="10" />
    <arg name="obstacle_end_sample" value="20" />
  </include>

  <node pkg="stier_slam_core" type="vehicle_odometry_node.py"
        name="wheel_odometry" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/vehicle.yaml" />
    <param name="real_mode" value="false" />
  </node>

  <node pkg="stier_slam_core" type="scan_leveler_node.py"
        name="scan_leveler" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/scan_leveling.yaml" />
  </node>

  <node pkg="stier_slam_core" type="rtk_gate_node.py"
        name="rtk_gate" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/rtk_gate.yaml" />
  </node>

  <node pkg="robot_localization" type="ekf_localization_node"
        name="ekf_local" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/ekf_local.yaml" />
    <param name="publish_tf" value="true" />
    <remap from="odometry/filtered" to="/slam/odometry/local" />
  </node>

  <node pkg="map_server" type="map_server" name="synthetic_released_map_server"
        args="$(find stier_slam_test_support)/maps/demo/base.yaml"
        output="screen" required="true">
    <remap from="map" to="/slam/map/released" />
  </node>

  <!--
    TEST FIXTURE ONLY: identity map -> odom makes the processed graph observable.
    It is not RTAB-Map, loop-closure, database, or localization evidence.
  -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="synthetic_map_to_odom_fixture"
        args="0 0 0 0 0 0 1 map odom" output="screen" required="true" />

  <node pkg="stier_slam_core" type="live_obstacle_node.py"
        name="live_obstacles" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/live_obstacles.yaml" />
    <param name="local_grid_width" value="40" />
    <param name="local_grid_height" value="20" />
    <param name="local_grid_resolution" value="0.10" />
  </node>

  <node pkg="stier_slam_core" type="sensor_health_node.py"
        name="sensor_health" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/timeouts.yaml" />
  </node>

  <test test-name="synthetic_pipeline_smoke" pkg="stier_slam_bringup"
        type="test_synthetic_pipeline_smoke.py" time-limit="30.0" />
</launch>

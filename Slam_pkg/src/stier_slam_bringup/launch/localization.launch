<launch>
  <arg name="real_mode" default="false" />
  <arg name="calibration_required" default="true" />
  <!-- Immutable source artifacts are explicit operator inputs. -->
  <arg name="database_path" />
  <arg name="map_yaml" />
  <arg name="release_manifest" />
  <arg name="runtime_root_dir" default="$(env HOME)/.ros/stier_slam_runtime" />
  <arg name="runtime_bundle_dir" default="$(arg runtime_root_dir)/$(anon localization)" />
  <arg name="use_sim_time" default="false" />
  <arg name="rviz" default="false" />

  <param name="use_sim_time" value="$(arg use_sim_time)" />
  <rosparam command="load" file="$(find stier_slam_bringup)/config/topics.yaml" />

  <node pkg="stier_slam_core" type="wheel_encoder_adapter_node.py"
        name="wheel_encoder_adapter" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/encoder.yaml" />
    <param name="real_mode" value="$(arg real_mode)" />
    <param name="calibration_required" value="$(arg calibration_required)" />
  </node>

  <!-- The input must be an immutable release selected by the operator. -->
  <node pkg="map_server" type="map_server" name="released_map_server" args="&quot;$(arg runtime_bundle_dir)/map.yaml&quot;" output="screen" required="true"
        launch-prefix="rosrun stier_slam_core rtabmap_runtime_guard.py --release-manifest &quot;$(arg release_manifest)&quot; --map-yaml &quot;$(arg map_yaml)&quot; --source-database &quot;$(arg database_path)&quot; --source-config &quot;$(find stier_slam_bringup)/config/rtabmap_localization.ini&quot; --runtime-root &quot;$(arg runtime_root_dir)&quot; --runtime-bundle &quot;$(arg runtime_bundle_dir)&quot; --bundle-role map-server --">
    <remap from="map" to="/slam/map/released" />
  </node>

  <node pkg="stier_slam_core" type="vehicle_odometry_node.py" name="wheel_odometry" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/vehicle.yaml" />
    <param name="real_mode" value="$(arg real_mode)" />
    <param name="calibration_required" value="$(arg calibration_required)" />
  </node>

  <node pkg="stier_slam_core" type="scan_leveler_node.py" name="scan_leveler" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/scan_leveling.yaml" />
  </node>

  <node pkg="stier_slam_core" type="rtk_gate_node.py" name="rtk_gate" output="screen">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/rtk_gate.yaml" />
  </node>

  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_local" output="screen" required="true">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/ekf_local.yaml" />
    <param name="publish_tf" value="true" />
    <remap from="odometry/filtered" to="/slam/odometry/local" />
  </node>

  <!-- RTAB-Map is the sole publisher of map -> odom and loads a frozen database. -->
  <node pkg="rtabmap_slam" type="rtabmap" name="rtabmap" output="screen" required="true"
        launch-prefix="rosrun stier_slam_core rtabmap_runtime_guard.py --release-manifest &quot;$(arg release_manifest)&quot; --map-yaml &quot;$(arg map_yaml)&quot; --source-database &quot;$(arg database_path)&quot; --source-config &quot;$(find stier_slam_bringup)/config/rtabmap_localization.ini&quot; --runtime-root &quot;$(arg runtime_root_dir)&quot; --runtime-bundle &quot;$(arg runtime_bundle_dir)&quot; --bundle-role rtabmap --">
    <param name="frame_id" value="base_link" />
    <param name="map_frame_id" value="map" />
    <param name="odom_frame_id" type="string" value="" />
    <param name="publish_tf" value="true" />
    <param name="database_path" type="string" value="$(arg runtime_bundle_dir)/map.db" />
    <param name="config_path" type="string" value="$(arg runtime_bundle_dir)/rtabmap.ini" />
    <param name="Mem/IncrementalMemory" type="string" value="false" />
    <param name="subscribe_depth" type="bool" value="false" />
    <param name="subscribe_rgb" type="bool" value="false" />
    <param name="subscribe_rgbd" type="bool" value="false" />
    <param name="subscribe_stereo" type="bool" value="false" />
    <param name="subscribe_scan" type="bool" value="false" />
    <param name="subscribe_scan_cloud" type="bool" value="true" />
    <param name="scan_cloud_is_2d" value="true" />
    <param name="Reg/Force3DoF" type="string" value="true" />
    <remap from="scan_cloud" to="/slam/scan/leveled_points" />
    <remap from="odom" to="/slam/odometry/local" />
    <remap from="imu" to="/slam/input/imu" />
    <remap from="gps/fix" to="/slam/gnss/fix_accepted" />
    <remap from="localization_pose" to="/slam/localization/pose" />
  </node>

  <node pkg="stier_slam_core" type="live_obstacle_node.py" name="live_obstacles" output="screen">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/live_obstacles.yaml" />
  </node>

  <node pkg="stier_slam_core" type="sensor_health_node.py" name="sensor_health" output="screen">
    <rosparam command="load" file="$(find stier_slam_bringup)/config/timeouts.yaml" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find stier_slam_bringup)/rviz/slam.rviz" />
</launch>
